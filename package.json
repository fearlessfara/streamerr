{
  "name": "streamerr",
  "version": "0.1.0",
  "private": true,
  "description": "Streamerr — Your media. One stream.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm run dev -w @streamerr/api",
    "dev:web": "npm run dev -w @streamerr/web",
    "dev:tv": "npm run start -w @streamerr/tv",
    "dev:mobile": "npm run start -w @streamerr/mobile",
    "build": "npm run build -w @streamerr/shared && npm run build -w @streamerr/client && npm run build -w @streamerr/providers && npm run build -w @streamerr/api && npm run build -w @streamerr/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "react-native": "npm:react-native-tvos@0.86.3-0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
